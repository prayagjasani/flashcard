  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.5",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19",
    "vite": "^7.0.0"
  }
}
